---
import { Picture } from 'astro:assets';
import { photo } from '~/lib/photos';

interface Props {
  dir: string;
  name: string;
  alt: string;
  /** CSS sizes attribute; defaults to full width. */
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { dir, name, alt, sizes = '100vw', eager = false, class: cls } = Astro.props;
const src = photo(dir, name);
const widths = [480, 960, 1440, 2000].filter((w) => w <= src.width);
if (!widths.length) widths.push(src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  class={cls}
/>
